{
  "name": "Tiny Explorers 3D",
  "short_name": "Tiny Explorers",
  "description": "A gentle 3D learning game for toddlers: colors, shapes and counting.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "any",
  "background_color": "#a6e1ff",
  "theme_color": "#a6e1ff",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
